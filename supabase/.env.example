# Secretos de las Edge Functions de Lovel House.
# Copia a supabase/.env y súbelos con:  supabase secrets set --env-file supabase/.env
# (SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase automáticamente.)

# --- IA del avatar: elige proveedor ("gemini" tiene plan gratuito, "anthropic" = Claude)
AI_PROVIDER=gemini

# --- Google Gemini · chat del avatar y análisis de fotos
GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.5-flash-lite   # rápido (~1 s por respuesta)

# --- Claude (Anthropic) · alternativa de pago
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_EFFORT=low            # low | medium | high

# --- ElevenLabs · voz del avatar (TTS) y transcripción (Scribe)
ELEVENLABS_API_KEY=...
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_STT_MODEL=scribe_v1
# ELEVENLABS_VOICE_FEMALE=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_VOICE_FEMALE_MATURE=XrExE9yKIg1WjnnlVkGX
# ELEVENLABS_VOICE_MALE=TX3LPaxmHKxFdv7VOQHJ
# ELEVENLABS_VOICE_MALE_MATURE=nPczCjzI2devNBz1zQrb
# ELEVENLABS_VOICE_OTHER=SAz9YHcvj6GT2YYXdXww

# --- Leonardo.ai · retratos ilustrados (Pro)
LEONARDO_API_KEY=...
# LEONARDO_MODEL_ID=de7d3faf-762f-48e0-b3b7-9d0ac3a3fcf3

# --- Stripe · suscripción Pro $9.90/mes
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...   # opcional: si no, se usa $9.90 USD/mes en línea
# URLs a las que se puede volver tras pagar (separadas por coma)
ALLOWED_RETURN_URLS=lovelhouse://,exp://,http://localhost:8081
